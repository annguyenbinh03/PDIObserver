<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function saveNewPDI() {
    var url = $j('#pdiUrl').val();
    var user = $j('#pdiUser').val();
    var pass = $j('#pdiPass').val();
    
    if(!url || !user || !pass) {
        alert("Please provide URL, Username, and Password!");
        return;
    }
    
    $j('#addPdiModal').modal('hide');
    alert("PDI configuration received for: " + url + "\n(GlideAjax logic to insert record will be added here)");
    $j('#pdiForm')[0].reset();
}

function pingInstance(pdiName) {
    alert("Triggering REST Message to ping " + pdiName + "...");
}]]></client_script>
        <description>Main UI Page for PDIObserver to monitor and manage Personal Developer Instances (PDIs).</description>
        <direct>false</direct>
        <endpoint>x_1836491_pdiobs_0_PDIDashboard.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8" ?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
    
    <div class="container-fluid" style="margin-top: 20px;">
        <div class="row">
            <!-- 9-column PDI List -->
            <div class="col-md-9">
                <div class="panel panel-default">
                    <div class="panel-heading" style="overflow: hidden;">
                        <h3 class="panel-title pull-left" style="margin-top: 5px;">
                            <span class="glyphicon glyphicon-th-list" style="margin-right: 8px;"></span> 
                            Personal Developer Instances Management
                        </h3>
                        <button class="btn btn-primary btn-sm pull-right" data-toggle="modal" data-target="#addPdiModal">
                            <span class="glyphicon glyphicon-plus"></span> Add PDI
                        </button>
                    </div>
                    
                    <div class="panel-body">
                        <table class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>Instance URL</th>
                                    <th>Version</th>
                                    <th>Status</th>
                                    <th>Last Checked</th>
                                    <th style="text-align: center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Static mock data -->
                                <tr>
                                    <td><strong>https://dev12345.service-now.com</strong></td>
                                    <td>Washington DC</td>
                                    <td><span class="label label-success">Online</span></td>
                                    <td>10 mins ago</td>
                                    <td style="text-align: center;">
                                        <button class="btn btn-default btn-xs" title="Ping Now" onclick="pingInstance('dev12345')">
                                            <span class="glyphicon glyphicon-refresh"></span>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <!-- 3-column Dashboard -->
            <div class="col-md-3">
                <div class="panel panel-primary">
                    <div class="panel-heading">
                        <h3 class="panel-title">
                            <span class="glyphicon glyphicon-dashboard" style="margin-right: 5px;"></span> Overview
                        </h3>
                    </div>
                    <ul class="list-group">
                        <li class="list-group-item">
                            <span class="badge" style="background-color: #337ab7;">1</span> Total PDIs
                        </li>
                        <li class="list-group-item">
                            <span class="badge" style="background-color: #5cb85c;">1</span> Online
                        </li>
                        <li class="list-group-item">
                            <span class="badge" style="background-color: #d9534f;">0</span> Offline / Hibernating
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Add PDI Modal -->
    <div class="modal fade" id="addPdiModal" tabindex="-1" role="dialog" aria-labelledby="addPdiModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&#215;</span>
                    </button>
                    <h4 class="modal-title" id="addPdiModalLabel">Register New PDI</h4>
                </div>
                <div class="modal-body">
                    <form id="pdiForm">
                        <div class="form-group">
                            <label for="pdiUrl">Instance URL</label>
                            <input type="text" class="form-control" id="pdiUrl" placeholder="https://devXXXXX.service-now.com" />
                        </div>
                        <div class="form-group">
                            <label for="pdiUser">Username (API User)</label>
                            <input type="text" class="form-control" id="pdiUser" placeholder="admin" />
                        </div>
                        <div class="form-group">
                            <label for="pdiPass">Password</label>
                            <input type="password" class="form-control" id="pdiPass" placeholder="Password" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveNewPDI()">Save Configuration</button>
                </div>
            </div>
        </div>
    </div>
</j:jelly>]]></html>
