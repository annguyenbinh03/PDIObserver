<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function saveNewPDI() {
    // 1. Get data from the form
    var url = $j('#pdiUrl').val().trim();
    var pEmail = $j('#portalEmail').val().trim();
    var pPass = $j('#portalPass').val();
    var iUser = $j('#instanceUser').val().trim();
    var iPass = $j('#instancePass').val();
    
    // 2. Perform basic validation
    if (!url) {
        alert("Please provide the Instance URL!");
        $j('#pdiUrl').focus();
        return;
    }
    
    // 3. Disable the button to prevent multiple clicks
    var btn = $j('#btnSavePDI');
    btn.prop('disabled', true).text('Saving...');
    
    // 4. Initialize GlideAjax
    var ga = new GlideAjax('PDIObserverAjax');
    ga.addParam('sysparm_name', 'registerNewPDI');
    
    // 5. Pass parameters to the server
    ga.addParam('sysparm_url', url);
    ga.addParam('sysparm_p_email', pEmail);
    ga.addParam('sysparm_p_pass', pPass);
    ga.addParam('sysparm_i_user', iUser);
    ga.addParam('sysparm_i_pass', iPass);
    
    // 6. Handle the server response
    ga.getXMLAnswer(function(answer) {
        btn.prop('disabled', false).text('Save Configuration');
        
        if (answer && answer.indexOf('SUCCESS') > -1) {
            $j('#addPdiModal').modal('hide');
            alert("PDI registered successfully!");
            $j('#pdiForm')[0].reset();
            
            // Reload the page to show the new record in the table
            window.location.reload(); 
        } else {
            alert("An error occurred while saving the PDI: " + answer);
        }
    });
}]]></client_script>
        <description>Main UI Page for PDIObserver to monitor and manage Personal Developer Instances (PDIs).</description>
